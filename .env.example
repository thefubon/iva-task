# Copy to .env: cp .env.example .env
# Local: pnpm dev

WEB_PORT=3033
CMS_PORT=3333
MONGO_PORT=27027

# Local replica set (docker-compose.yml). 27027 — чтобы не пересекаться с iva360-next на 27017.
MONGODB_URI=mongodb://127.0.0.1:27027/iva360?replicaSet=rs0&directConnection=true
PAYLOAD_SECRET=YOUR_SECRET_HERE

CMS_INTERNAL_URL=http://localhost:3333
CMS_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3033
PAYLOAD_SERVER_URL=http://localhost:3033
