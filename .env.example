# Copy to .env: cp .env.example .env
# Local: pnpm dev

WEB_PORT=3033
CMS_PORT=3333
MONGO_PORT=27027

# Local replica set (docker-compose.yml). 27027 — чтобы не пересекаться с iva360-next на 27017.
MONGODB_URI=mongodb://127.0.0.1:27027/iva360?replicaSet=rs0&directConnection=true
PAYLOAD_SECRET=iva360-demo-payload-secret-change-me!!

CMS_INTERNAL_URL=http://localhost:3333
CMS_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3033
PAYLOAD_SERVER_URL=http://localhost:3033

# MinIO (docker-compose). Порты 9002/9003 — не конфликтовать с iva360-next на 9000.
S3_BUCKET=iva360-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9002
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
